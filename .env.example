# 단감(DAN-GAM) 환경변수 예시
# 이 파일을 복사하여 .env를 만들고 실제 값을 입력하세요
# cp .env.example .env

# ===== 공통 =====
ENVIRONMENT=development  # development | test | production

# ===== PostgreSQL =====
POSTGRES_USER=danngam
POSTGRES_PASSWORD=danngam_secret_change_me
POSTGRES_DB=danngam
DATABASE_URL=postgresql+asyncpg://danngam:danngam_secret_change_me@postgres:5432/danngam

# ===== Redis =====
REDIS_PASSWORD=redis_secret_change_me
REDIS_URL=redis://:redis_secret_change_me@redis:6379

# ===== JWT =====
SECRET_KEY=your_super_secret_key_minimum_32_characters_change_me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ===== SMS (개발 환경에서는 mock 사용) =====
SMS_PROVIDER=mock  # mock | coolsms
COOLSMS_API_KEY=
COOLSMS_API_SECRET=
COOLSMS_SENDER_PHONE=

# ===== 카카오맵 =====
KAKAO_MAP_API_KEY=

# ===== CORS =====
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ===== 앱 설정 =====
APP_NAME=단감
APP_VERSION=0.1.0
DEBUG=true
